model CommercialProduct {
  id                  String    @id @db.Uuid
  ownerOrganizationId String    @map("owner_organization_id") @db.Uuid
  key                 String
  name                String
  description         String?
  currency            String    @db.Char(3)
  unitAmountMinor     BigInt    @map("unit_amount_minor")
  status              String    @default("ACTIVE")
  rowVersion          Int       @default(1) @map("row_version")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  archivedAt          DateTime? @map("archived_at") @db.Timestamptz(6)

  @@unique([ownerOrganizationId, key], map: "products_owner_key")
  @@index([ownerOrganizationId, archivedAt], map: "products_owner_archived")
  @@map("products")
  @@schema("commercial")
}

model CommercialProposal {
  id                    String    @id @db.Uuid
  resourceId            String    @unique @map("resource_id") @db.Uuid
  ownerOrganizationId   String    @map("owner_organization_id") @db.Uuid
  dealId                String    @map("deal_id") @db.Uuid
  clientAccountId       String?   @map("client_account_id") @db.Uuid
  status                String    @default("DRAFT")
  currentVersion        Int       @default(1) @map("current_version")
  currency              String    @db.Char(3)
  rowVersion            Int       @default(1) @map("row_version")
  createdByMembershipId String?   @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  archivedAt            DateTime? @map("archived_at") @db.Timestamptz(6)

  @@unique([id, ownerOrganizationId], map: "proposals_id_owner_org_key")
  @@index([ownerOrganizationId, dealId, status, archivedAt], map: "proposals_owner_deal")
  @@map("proposals")
  @@schema("commercial")
}

model CommercialProposalVersion {
  id                  String    @id @db.Uuid
  ownerOrganizationId String    @map("owner_organization_id") @db.Uuid
  proposalId          String    @map("proposal_id") @db.Uuid
  version             Int
  status              String    @default("DRAFT")
  issuedAt            DateTime? @map("issued_at") @db.Timestamptz(6)
  immutable           Boolean   @default(false)
  currency            String    @db.Char(3)
  subtotalMinor       BigInt    @map("subtotal_minor")
  taxMinor            BigInt    @default(0) @map("tax_minor")
  totalMinor          BigInt    @map("total_minor")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([proposalId, version], map: "proposal_versions_proposal_version")
  @@unique([id, proposalId, ownerOrganizationId, version], map: "proposal_versions_acceptance_reference_key")
  @@map("proposal_versions")
  @@schema("commercial")
}

model CommercialProposalLine {
  id                  String  @id @db.Uuid
  ownerOrganizationId String  @map("owner_organization_id") @db.Uuid
  proposalVersionId   String  @map("proposal_version_id") @db.Uuid
  productId           String? @map("product_id") @db.Uuid
  description         String
  quantity            Int
  unitAmountMinor     BigInt  @map("unit_amount_minor")
  lineTotalMinor      BigInt  @map("line_total_minor")
  position            Int

  @@map("proposal_lines")
  @@schema("commercial")
}

model CommercialProposalAcceptanceEvidence {
  id                  String   @id @db.Uuid
  ownerOrganizationId String   @map("owner_organization_id") @db.Uuid
  clientOrganizationId String  @map("client_organization_id") @db.Uuid
  clientAccountId     String   @map("client_account_id") @db.Uuid
  proposalId          String   @unique(map: "proposal_acceptances_proposal_once") @map("proposal_id") @db.Uuid
  proposalVersionId   String   @map("proposal_version_id") @db.Uuid
  proposalVersion     Int      @map("proposal_version")
  expectedRowVersion  Int      @map("expected_row_version")
  acceptedRowVersion  Int      @map("accepted_row_version")
  actorUserId         String   @map("actor_user_id") @db.Uuid
  actorMembershipId   String   @map("actor_membership_id") @db.Uuid
  acceptedAt          DateTime @map("accepted_at") @db.Timestamptz(6)
  idempotencyKey      String   @map("idempotency_key")
  requestHash         String   @map("request_hash")
  afterHash           String   @map("after_hash")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([id, ownerOrganizationId], map: "proposal_acceptances_id_owner_org_key")
  @@unique([clientOrganizationId, idempotencyKey], map: "proposal_acceptances_client_idempotency")
  @@index([ownerOrganizationId, proposalId, acceptedAt], map: "proposal_acceptances_owner_proposal_idx")
  @@map("proposal_acceptances")
  @@schema("commercial")
}

model CommercialInvoice {
  id                      String    @id @db.Uuid
  resourceId              String    @unique @map("resource_id") @db.Uuid
  ownerOrganizationId     String    @map("owner_organization_id") @db.Uuid
  clientAccountId         String    @map("client_account_id") @db.Uuid
  proposalId              String?   @map("proposal_id") @db.Uuid
  sourceContractId        String?   @map("source_contract_id") @db.Uuid
  sourceContractVersionId String?   @map("source_contract_version_id") @db.Uuid
  sourceContractVersion   Int?      @map("source_contract_version")
  status                  String    @default("DRAFT")
  currency                String    @db.Char(3)
  subtotalMinor           BigInt?   @map("subtotal_minor")
  taxMinor                BigInt?   @map("tax_minor")
  totalMinor              BigInt    @map("total_minor")
  allocatedMinor          BigInt    @default(0) @map("allocated_minor")
  idempotencyKey          String?   @map("idempotency_key")
  requestHash             String?   @map("request_hash") @db.Char(64)
  issueIdempotencyKey     String?   @map("issue_idempotency_key")
  issueRequestHash        String?   @map("issue_request_hash") @db.Char(64)
  finalizedAt             DateTime? @map("finalized_at") @db.Timestamptz(6)
  rowVersion              Int       @default(1) @map("row_version")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  archivedAt              DateTime? @map("archived_at") @db.Timestamptz(6)

  @@unique([id, ownerOrganizationId], map: "invoices_id_owner_org_key")
  @@index([ownerOrganizationId, clientAccountId, status, archivedAt], map: "invoices_owner_client")
  @@map("invoices")
  @@schema("commercial")
}

model CommercialInvoiceLine {
  id                  String @id @db.Uuid
  ownerOrganizationId String @map("owner_organization_id") @db.Uuid
  invoiceId           String @map("invoice_id") @db.Uuid
  position            Int
  description         String
  quantity            Int
  unitAmountMinor     BigInt @map("unit_amount_minor")
  lineTotalMinor      BigInt @map("line_total_minor")

  @@unique([invoiceId, position], map: "invoice_lines_position")
  @@map("invoice_lines")
  @@schema("commercial")
}

model CommercialPayment {
  id                  String   @id @db.Uuid
  ownerOrganizationId String   @map("owner_organization_id") @db.Uuid
  invoiceId           String?  @map("invoice_id") @db.Uuid
  provider            String
  providerEventId     String?  @map("provider_event_id")
  status              String   @default("CREATED")
  currency            String   @db.Char(3)
  amountMinor         BigInt   @map("amount_minor")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, providerEventId], map: "payments_provider_event")
  @@index([ownerOrganizationId, invoiceId, status], map: "payments_owner_invoice")
  @@map("payments")
  @@schema("commercial")
}

model CommercialLedgerEntry {
  id                  String   @id @db.Uuid
  ownerOrganizationId String   @map("owner_organization_id") @db.Uuid
  invoiceId           String?  @map("invoice_id") @db.Uuid
  paymentId           String?  @map("payment_id") @db.Uuid
  entryType           String   @map("entry_type")
  currency            String   @db.Char(3)
  amountMinor         BigInt   @map("amount_minor")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ownerOrganizationId, invoiceId, createdAt], map: "ledger_owner_invoice")
  @@map("ledger_entries")
  @@schema("commercial")
}

model CommercialSubscription {
  id                  String    @id @db.Uuid
  resourceId          String    @unique @map("resource_id") @db.Uuid
  ownerOrganizationId String    @map("owner_organization_id") @db.Uuid
  clientAccountId     String    @map("client_account_id") @db.Uuid
  status              String    @default("ACTIVE")
  currency            String    @db.Char(3)
  periodStart         DateTime? @map("period_start") @db.Timestamptz(6)
  periodEnd           DateTime? @map("period_end") @db.Timestamptz(6)
  rowVersion          Int       @default(1) @map("row_version")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  archivedAt          DateTime? @map("archived_at") @db.Timestamptz(6)

  @@index([ownerOrganizationId, clientAccountId, status], map: "subscriptions_owner_client")
  @@map("subscriptions")
  @@schema("commercial")
}

model CommercialEntitlement {
  id                  String    @id @db.Uuid
  ownerOrganizationId String    @map("owner_organization_id") @db.Uuid
  subjectType         String    @map("subject_type")
  subjectId           String    @map("subject_id") @db.Uuid
  entitlementKey      String    @map("entitlement_key")
  sourceType          String    @map("source_type")
  sourceId            String    @map("source_id") @db.Uuid
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@index([ownerOrganizationId, subjectType, subjectId, active], map: "entitlements_owner_subject")
  @@map("entitlements")
  @@schema("commercial")
}

model CommercialContract {
  id                      String   @id @db.Uuid
  resourceId              String   @unique @map("resource_id") @db.Uuid
  ownerOrganizationId     String   @map("owner_organization_id") @db.Uuid
  clientAccountId         String   @map("client_account_id") @db.Uuid
  sourceProposalId        String   @map("source_proposal_id") @db.Uuid
  sourceProposalVersionId String   @map("source_proposal_version_id") @db.Uuid
  sourceProposalVersion   Int      @map("source_proposal_version")
  status                  String   @default("DRAFT")
  currentVersion          Int      @default(1) @map("current_version")
  rowVersion              Int      @default(1) @map("row_version")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([id, ownerOrganizationId], map: "contracts_id_owner_org_key")
  @@unique([id, ownerOrganizationId, sourceProposalId, sourceProposalVersionId, sourceProposalVersion], map: "contracts_source_identity_key")
  @@unique([sourceProposalId, sourceProposalVersion], map: "contracts_source_proposal_version")
  @@index([ownerOrganizationId, clientAccountId, status], map: "contracts_owner_client_status")
  @@map("contracts")
  @@schema("commercial")
}

model CommercialContractVersion {
  id                      String    @id @db.Uuid
  ownerOrganizationId     String    @map("owner_organization_id") @db.Uuid
  contractId              String    @map("contract_id") @db.Uuid
  version                 Int
  sourceProposalId        String    @map("source_proposal_id") @db.Uuid
  sourceProposalVersionId String    @map("source_proposal_version_id") @db.Uuid
  sourceProposalVersion   Int       @map("source_proposal_version")
  status                  String    @default("DRAFT")
  immutable               Boolean   @default(true)
  documentSnapshot        Json      @map("document_snapshot")
  documentSha256          String    @map("document_sha256") @db.Char(64)
  currency                String    @db.Char(3)
  subtotalMinor           BigInt    @map("subtotal_minor")
  taxMinor                BigInt    @default(0) @map("tax_minor")
  totalMinor              BigInt    @map("total_minor")
  createdAuditEventId     String    @map("created_audit_event_id") @db.Uuid
  issuedAt                DateTime? @map("issued_at") @db.Timestamptz(6)
  signedAt                DateTime? @map("signed_at") @db.Timestamptz(6)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([contractId, version], map: "contract_versions_contract_version")
  @@unique([id, contractId, ownerOrganizationId, version], map: "contract_versions_reference_key")
  @@index([ownerOrganizationId, status, contractId], map: "contract_versions_owner_status")
  @@map("contract_versions")
  @@schema("commercial")
}

model CommercialContractSigner {
  id                  String  @id @db.Uuid
  ownerOrganizationId String  @map("owner_organization_id") @db.Uuid
  contractId          String  @map("contract_id") @db.Uuid
  contractVersionId   String  @map("contract_version_id") @db.Uuid
  contractVersion     Int     @map("contract_version")
  signerKey           String  @map("signer_key")
  signerKind          String  @map("signer_kind")
  required            Boolean @default(true)
  providerSignerId    String? @map("provider_signer_id")

  @@unique([contractVersionId, signerKey], map: "contract_signers_version_signer")
  @@unique([id, ownerOrganizationId], map: "contract_signers_id_owner_org_key")
  @@index([ownerOrganizationId, contractId, contractVersion], map: "contract_signers_owner_contract_version")
  @@map("contract_signers")
  @@schema("commercial")
}

model CommercialSignatureRequest {
  id                  String    @id @db.Uuid
  ownerOrganizationId String    @map("owner_organization_id") @db.Uuid
  contractId          String    @map("contract_id") @db.Uuid
  contractVersionId   String    @map("contract_version_id") @db.Uuid
  contractVersion     Int       @map("contract_version")
  provider            String
  providerRequestId   String?   @map("provider_request_id")
  status              String    @default("REQUESTED")
  documentSha256      String    @map("document_sha256") @db.Char(64)
  idempotencyKey      String    @map("idempotency_key")
  requestHash         String    @map("request_hash") @db.Char(64)
  auditEventId        String    @map("audit_event_id") @db.Uuid
  requestedAt         DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  completedAt         DateTime? @map("completed_at") @db.Timestamptz(6)

  @@unique([contractVersionId], map: "signature_requests_version_once")
  @@unique([provider, providerRequestId], map: "signature_requests_provider_request")
  @@unique([ownerOrganizationId, idempotencyKey], map: "signature_requests_owner_idempotency")
  @@unique([id, ownerOrganizationId], map: "signature_requests_id_owner_org_key")
  @@index([ownerOrganizationId, status, requestedAt], map: "signature_requests_owner_status")
  @@map("signature_requests")
  @@schema("commercial")
}

model CommercialSignatureEvent {
  id                  String    @id @db.Uuid
  ownerOrganizationId String    @map("owner_organization_id") @db.Uuid
  signatureRequestId  String    @map("signature_request_id") @db.Uuid
  provider            String
  providerEventId     String    @map("provider_event_id")
  eventType           String    @map("event_type")
  eventHash           String    @map("event_hash") @db.Char(64)
  signerKey           String?   @map("signer_key")
  providerOccurredAt  DateTime? @map("provider_occurred_at") @db.Timestamptz(6)
  receivedAt          DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  verifiedAt          DateTime  @map("verified_at") @db.Timestamptz(6)
  normalizedEvidence  Json      @map("normalized_evidence")
  appliedAt           DateTime? @map("applied_at") @db.Timestamptz(6)
  auditEventId        String    @map("audit_event_id") @db.Uuid

  @@unique([provider, providerEventId], map: "signature_events_provider_event")
  @@unique([id, ownerOrganizationId], map: "signature_events_id_owner_org_key")
  @@index([ownerOrganizationId, signatureRequestId, receivedAt], map: "signature_events_owner_request")
  @@map("signature_events")
  @@schema("commercial")
}

